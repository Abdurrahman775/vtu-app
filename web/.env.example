# Payment gateway (Phase 1 uses one: Paystack)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# VTU provider (airtime/data/cable reseller API)
VTU_PROVIDER_BASE_URL=""
VTU_PROVIDER_API_KEY=""
