# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/vtu_app?schema=public"

# JWT signing secret (auth sessions)
JWT_SECRET="change-me-to-a-long-random-string"

# Email/OTP delivery via Gmail SMTP. SMTP_PASS must be a Google Account
# "App Password" (myaccount.google.com/apppasswords), not the account's
# normal login password — Gmail rejects the real password for SMTP auth,
# and app passwords require 2-Step Verification to be enabled first.
# Leave blank in dev: OTPs fall back to a fixed code (123456) logged to
# the server console instead of being emailed — see web/src/lib/otp.ts.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Payment gateway (Phase 1 uses one: Paystack). Webhooks are verified
# with PAYSTACK_SECRET_KEY itself (Paystack signs with the secret key,
# not a separate webhook secret) — see web/src/app/api/wallet/webhook/route.ts
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# VTU provider (airtime/data/cable reseller API)
VTU_PROVIDER_BASE_URL=""
VTU_PROVIDER_API_KEY=""
