# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/vtu_app?schema=public"

# JWT signing secret (auth sessions)
JWT_SECRET="change-me-to-a-long-random-string"

# SMS/OTP provider (e.g. Termii, Twilio)
SMS_PROVIDER_API_KEY=""
