generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum TransactionType {
  WALLET_FUNDING
  AIRTIME
  DATA
  CABLE_TV
  EXAM_PIN
  ELECTRICITY
  TRANSFER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  /// Login identifier (OTP is emailed here). Required at signup.
  email        String   @unique
  /// Not collected at signup — email+OTP is the only login flow. Kept
  /// around (nullable) only because wallet-to-wallet transfers still
  /// look up a recipient by phone; see docs/AUTH.md, docs/TRANSFER.md.
  phone        String?  @unique
  fullName     String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)

  /// Local file path under public/uploads for now — see docs/PROFILE_MEDIA.md
  /// for why this needs to move to real object storage before production.
  avatarUrl    String?

  /// Set by an admin approving a VerificationRequest, not self-service.
  isVerified   Boolean  @default(false)

  /// bcrypt hash of a 4-digit transaction PIN, set/changed from the
  /// mobile Profile screen (POST /api/me/pin). Null until the user sets
  /// one — see docs/TRANSACTION_PIN.md for why it's optional rather than
  /// required at signup, and how it gates transfers/purchases once set.
  pinHash            String?
  /// Consecutive wrong-PIN count, reset to 0 on a correct PIN or a
  /// successful OTP-gated reset. Locks the account out of transacting
  /// once it hits the threshold in web/src/lib/pin.ts.
  pinFailedAttempts  Int       @default(0)
  /// Set when pinFailedAttempts hits the lockout threshold; null once
  /// the lockout window passes or the PIN is reset via OTP.
  pinLockedUntil     DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet               Wallet?
  transactions         Transaction[]
  otpCodes             OtpCode[]
  reports              TransactionReport[]
  verificationRequests VerificationRequest[]
  notifications        Notification[]
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Lightweight identity-verification flow: user submits a request (with an
/// optional note), an admin approves/rejects it, approval flips
/// User.isVerified so the profile shows a "Verified" badge. This is not a
/// real KYC document-upload pipeline — see docs/VERIFICATION.md.
model VerificationRequest {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  note       String?
  status     VerificationStatus  @default(PENDING)
  createdAt  DateTime            @default(now())
  reviewedAt DateTime?
}

/// Email + OTP is the only auth flow in Phase 1 (no passwords).
model OtpCode {
  id          String    @id @default(cuid())
  email       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([email])
}

/// balances are stored in kobo (integer) to avoid floating point drift.
model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  balanceKobo    BigInt   @default(0)
  currency       String   @default("NGN")

  /// Dedicated virtual account (Paystack DVA or similar) for bank-transfer
  /// funding — nullable because provisioning one requires business KYB
  /// approval not yet in place; null until that's wired up.
  virtualAccountNumber   String?
  virtualAccountBankName String?
  virtualAccountName     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ledgerEntries  LedgerEntry[]
}

/// Append-only ledger: every wallet balance change must be recorded here.
model LedgerEntry {
  id                String          @id @default(cuid())
  walletId          String
  wallet            Wallet          @relation(fields: [walletId], references: [id])
  type              LedgerEntryType
  amountKobo        BigInt
  balanceAfterKobo  BigInt
  reference         String          @unique
  description       String
  transactionId     String?         @unique
  transaction       Transaction?    @relation(fields: [transactionId], references: [id])
  createdAt         DateTime        @default(now())
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id])
  type               TransactionType
  provider           String
  amountKobo         BigInt
  status             TransactionStatus @default(PENDING)
  reference          String            @unique
  providerReference  String?
  meta               Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  ledgerEntry        LedgerEntry?
  reports            TransactionReport[]
}

/// A user flagging a problem with one of their own transactions (e.g.
/// "airtime never arrived") for an admin to look into.
model TransactionReport {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  reason        String
  message       String?
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
}

enum NotificationType {
  TRANSACTION
  WALLET
  TRANSFER
  SYSTEM
}

/// In-app notification, e.g. "your airtime purchase succeeded" or "wallet
/// funded". Auto-created by the purchase/wallet/transfer flows — see
/// docs/NOTIFICATIONS.md. Not push (no FCM wired up yet); the mobile app
/// polls GET /api/notifications.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

/// Admin-configurable margin per provider/service, used to price purchases above cost.
model PricingRule {
  id            String          @id @default(cuid())
  service       TransactionType
  provider      String
  marginPercent Float           @default(0)
  updatedAt     DateTime        @updatedAt

  @@unique([service, provider])
}

/// Admin-uploaded logo image for a provider code (e.g. "MTN", "DSTV",
/// "IKEDC") shown in the mobile app's provider pickers/transaction list.
/// `provider` isn't a foreign key to anything — it's just whatever
/// string code the mobile app already uses (see
/// `mobile/lib/src/core/widgets/provider_badge.dart`'s `providerBrands`
/// map), so a logo can be uploaded before or after that code otherwise
/// exists anywhere. No row for a provider = falls back to a generated
/// color badge — see docs/PROVIDER_LOGOS.md.
model ProviderLogo {
  id        String   @id @default(cuid())
  provider  String   @unique
  imageUrl  String
  updatedAt DateTime @updatedAt
}
